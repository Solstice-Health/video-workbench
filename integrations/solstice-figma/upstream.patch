+def test_forwarded_auth0_callback_or_final_figma_url_fails_browser_binding(setup):
+    service, vault, _, calls, _ = setup
+    result = service.connect(SHARED_SUB)
+    ticket = parse_qs(urlsplit(result["authorization_url"]).query)["ticket"][0]
+    started = service.start_browser(ticket)
+    identity_state = parse_qs(urlsplit(started["url"]).query)["state"][0]
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.identity_callback(state=identity_state, code="code", browser_secret="x" * 43)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.identity_callback(state=identity_state, code="code", browser_secret=started["cookie"])
+    _, state, cookie = figma_flow(service)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=state, code="victim-figma-code", browser_secret=None)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=state, code="victim-figma-code", browser_secret=cookie)
+    assert not calls
+    with vault.sessions() as session:
+        assert session.execute(select(FigmaGrant)).scalar_one().payload is None
+
