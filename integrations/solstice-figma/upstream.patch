+"""No live Figma requests: exercise durable grants, authority and bounded output."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from urllib.parse import parse_qs, urlsplit
+
+import httpx
+import pytest
+from conftest import SHARED_SUB, TEST_ISSUER, TEST_RESOURCE
+from cryptography.fernet import Fernet
+from sqlalchemy import create_engine, inspect, select, text
+from sqlalchemy.exc import OperationalError
+from sqlalchemy.orm import sessionmaker
+from starlette.testclient import TestClient
+
+from solstice_mcp.app import build_mcp_app
+from solstice_mcp.auth import JWKSCache
+from solstice_mcp.figma import (
+    API,
+    FigmaBase,
+    FigmaConfig,
+    FigmaError,
+    FigmaGrant,
+    FigmaHTTPError,
+    FigmaPending,
+    FigmaService,
+    FigmaVault,
+)
+from solstice_mcp.settings import Settings
+
+
+@pytest.fixture
+def setup(tmp_path):
+    engine = create_engine("sqlite:///" + str(tmp_path / "grants.sqlite"), connect_args={"check_same_thread": False})
+    FigmaBase.metadata.create_all(engine)  # Tests only; production has an explicit migration.
+    with engine.begin() as connection:
+        connection.execute(text("CREATE TABLE solstice_figma_schema(version INTEGER PRIMARY KEY)"))
+        connection.execute(text("INSERT INTO solstice_figma_schema VALUES (1)"))
+    sessions = sessionmaker(engine, expire_on_commit=False)
+    config = FigmaConfig(
+        "figma-app", "figma-secret", "https://mcp.test.local/mcp/figma/callback", Fernet.generate_key().decode()
+    )
+    vault = FigmaVault(sessions, config, allow_sqlite=True)
+    now = [1000.0]
+    calls = []
+    response = {
+        "access_token": "figma-access",
+        "refresh_token": "figma-refresh",
+        "expires_in": 3600,
+        "user_id_string": "12345678901234567890",
+    }
+
+    def handler(request):
+        calls.append(request)
+        if request.url.path.startswith("/v1/oauth/"):
+            return httpx.Response(200, json=response)
+        if request.url.path == "/v1/me":
+            return httpx.Response(200, json={"id": response["user_id_string"]})
+        return httpx.Response(200, json={"document": {"id": "0:0", "name": "Example"}})
+
+    client = httpx.Client(transport=httpx.MockTransport(handler))
+
+    class Identity:
+        subject = SHARED_SUB
+
+        def authorization_url(self, *, state, nonce, verifier):
+            from urllib.parse import urlencode
+
+            return "https://test.auth0.local/authorize?" + urlencode({"state": state, "nonce": nonce})
+
+        def exchange(self, *, code, verifier, nonce):
+            assert code and verifier and nonce
+            return self.subject
+
+    service = FigmaService(vault, identity=Identity(), client=client, now=lambda: now[0])
+    yield service, vault, now, calls, response
+    client.close()
+    engine.dispose()
+
+
+def figma_flow(service, subject=SHARED_SUB):
+    service.identity.subject = subject
+    result = service.connect(subject)
+    ticket = parse_qs(urlsplit(result["authorization_url"]).query)["ticket"][0]
+    started = service.start_browser(ticket)
+    identity_state = parse_qs(urlsplit(started["url"]).query)["state"][0]
+    verified = service.identity_callback(state=identity_state, code="identity-code", browser_secret=started["cookie"])
+    state = parse_qs(urlsplit(verified["url"]).query)["state"][0]
+    return result, state, verified["cookie"]
+
+
+def authorize(service, subject=SHARED_SUB):
+    result, state, cookie = figma_flow(service, subject)
+    service.callback(state=state, code="authorization-code", browser_secret=cookie)
+    return result, state
+
+
+def test_oauth_subject_binding_pkce_encryption_and_auth_separation(setup):
+    service, vault, _, calls, _ = setup
+    result = service.connect(SHARED_SUB)
+    ticket = parse_qs(urlsplit(result["authorization_url"]).query)["ticket"][0]
+    started = service.start_browser(ticket)
+    identity_state = parse_qs(urlsplit(started["url"]).query)["state"][0]
+    verified = service.identity_callback(state=identity_state, code="identity-code", browser_secret=started["cookie"])
+    query = parse_qs(urlsplit(verified["url"]).query)
+    state = query["state"][0]
+    assert query["scope"] == ["file_content:read current_user:read"]
+    assert query["code_challenge_method"] == ["S256"]
+    with vault.sessions() as session:
+        pending = session.execute(select(FigmaPending)).scalar_one()
+        assert pending.subject == SHARED_SUB and pending.state_hash == hashlib.sha256(state.encode()).hexdigest()
+        verifier = vault.unseal(vault.binding(SHARED_SUB, pending.state_hash), pending.verifier)["verifier"]
+        assert state not in pending.verifier and verifier not in pending.verifier
+    assert query["code_challenge"] == [
+        base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
+    ]
+    service.callback(state=state, code="code-secret", browser_secret=verified["cookie"])
+    token_call = calls[0]
+    assert str(token_call.url) == API + "/v1/oauth/token"
+    assert token_call.headers["authorization"] == "Basic " + base64.b64encode(b"figma-app:figma-secret").decode()
+    assert parse_qs(token_call.content.decode())["code_verifier"] == [verifier]
+    assert "code-secret" not in str(token_call.url)
+    with vault.sessions() as session:
+        assert session.execute(select(FigmaPending)).scalar_one_or_none() is None
+        grant = session.execute(select(FigmaGrant)).scalar_one()
+        assert grant.subject == SHARED_SUB
+        assert "figma-access" not in grant.payload and "figma-refresh" not in grant.payload
+    status = service.status(SHARED_SUB)
+    assert status["connected"] and status["figma_user_id"] == "12345678901234567890"
+    assert calls[-1].headers["authorization"] == "Bearer figma-access"
+    assert not service.status("auth0|other")["connected"]
+    assert "figma-access" not in json.dumps(status)
+
+
+def test_callback_state_is_expiring_single_use_and_denial_consumes_it(setup):
+    service, _, now, calls, _ = setup
+    _, state = authorize(service)
+    before = len(calls)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=state, code="second-code")
+    assert len(calls) == before
+    _, expired, cookie = figma_flow(service)
+    now[0] += 601
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=expired, code="third-code", browser_secret=cookie)
+    _, denied, cookie = figma_flow(service)
+    with pytest.raises(FigmaError, match="authorization_denied"):
+        service.callback(state=denied, code=None, error="user-denied", browser_secret=cookie)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=denied, code="fourth-code")
+
+
+def test_new_connection_supersedes_prior_pending_flow(setup):
+    service, _, _, calls, _ = setup
+    first = service.connect(SHARED_SUB)
+    second = service.connect(SHARED_SUB)
+    first_state = parse_qs(urlsplit(first["authorization_url"]).query)["ticket"][0]
+    second_state = parse_qs(urlsplit(second["authorization_url"]).query)["ticket"][0]
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.start_browser(first_state)
+    assert not calls
+    assert service.start_browser(second_state)["url"].startswith("https://test.auth0.local/")
+
+
+def test_failed_exchange_cannot_replay_state(setup):
+    service, _, _, _, _ = setup
+    service.client = httpx.Client(transport=httpx.MockTransport(lambda _: httpx.Response(500, text="SECRET")))
+    _, state, cookie = figma_flow(service)
+    with pytest.raises(FigmaHTTPError) as error:
+        service.callback(state=state, code="secret-code", browser_secret=cookie)
+    assert "SECRET" not in str(error.value) and "secret-code" not in str(error.value)
+    with pytest.raises(FigmaError, match="state_invalid"):
+        service.callback(state=state, code="secret-code", browser_secret=cookie)
+
+
+def test_grant_ciphertext_cannot_be_swapped_between_subjects(setup):
+    service, vault, _, _, response = setup
+    authorize(service)
+    response["user_id_string"] = "other-figma-user"
+    authorize(service, "auth0|other")
+    with vault.transaction() as session:
+        original = vault.locked_grant(session, SHARED_SUB)
+        other = vault.locked_grant(session, "auth0|other")
+        other.payload = original.payload
+    status = service.status("auth0|other")
+    assert not status["connected"] and status["state"] == "figma_vault_invalid"
+
+
+def test_one_figma_account_cannot_be_bound_to_multiple_subjects(setup):
+    service, _, _, _, _ = setup
+    authorize(service)
+    with pytest.raises(FigmaError, match="account_linked"):
+        authorize(service, "auth0|other")
+    assert not service.status("auth0|other")["connected"]
+
+
+@pytest.mark.parametrize("rotate", [True, False])
+def test_refresh_atomically_preserves_or_rotates_refresh_token(setup, rotate):
+    service, vault, now, calls, response = setup
+    authorize(service)
+    now[0] += 3600
+    response["access_token"] = "new-access"
+    if rotate:
+        response["refresh_token"] = "new-refresh"
+    else:
+        del response["refresh_token"]
+    assert service.status(SHARED_SUB)["connected"]
+    refresh = next(call for call in calls if call.url.path == "/v1/oauth/refresh")
+    assert parse_qs(refresh.content.decode()) == {"refresh_token": ["figma-refresh"]}
+    with vault.sessions() as session:
+        row = session.execute(select(FigmaGrant)).scalar_one()
+        payload = vault.unseal(vault.binding(SHARED_SUB, "grant"), row.payload)
+        assert payload["refresh_token"] == ("new-refresh" if rotate else "figma-refresh")
+        assert payload["access_token"] == "new-access"
+
+
+def test_concurrent_expired_grant_requests_refresh_once_across_service_instances(setup):
+    service, vault, now, calls, response = setup
+    authorize(service)
+    now[0] += 3600
+    response["access_token"] = "new-access"
+    barrier = threading.Barrier(4)
+    services = [
+        FigmaService(vault, identity=service.identity, client=service.client, now=lambda: now[0]) for _ in range(4)
+    ]
+
+    def use(instance):
+        barrier.wait()
+        return instance._access(SHARED_SUB)
+
+    with ThreadPoolExecutor(4) as executor:
+        assert list(executor.map(use, services)) == ["new-access"] * 4
+    assert sum(call.url.path == "/v1/oauth/refresh" for call in calls) == 1
+    # A stale in-flight request reuses the already-rotated token without refreshing again.
+    assert service._access(SHARED_SUB, rejected="figma-access") == "new-access"
+    assert sum(call.url.path == "/v1/oauth/refresh" for call in calls) == 1
+
+
+def test_status_requires_live_identity_validation_not_only_cached_grant(setup):
+    service, _, _, _, _ = setup
