+def test_mcp_subject_is_verified_and_cannot_be_selected_by_tool_argument(
+    setup, app_harness, signing_material, mint_token
+):
+    service, _, _, _, _ = setup
+    authorize(service)
+    with mcp_client(service, app_harness, signing_material) as client:
+        tools = rpc(client, mint_token(), "tools/list").json()["result"]["tools"]
+        selected = {tool["name"]: tool for tool in tools if tool["name"].startswith("solstice_figma_")}
+        assert len(selected) == 4
+        assert selected["solstice_figma_connect"]["annotations"]["readOnlyHint"] is False
+        assert all("subject" not in tool["inputSchema"]["properties"] for tool in selected.values())
+        response = rpc(client, mint_token(sub="auth0|other"), "tools/call", name="solstice_figma_status", arguments={})
+        assert response.json()["result"]["structuredContent"]["connected"] is False
+        response = rpc(client, mint_token(), "tools/call", name="solstice_figma_status", arguments={})
+        assert response.json()["result"]["structuredContent"]["connected"] is True
+        assert (
+            client.post("/mcp", headers={"Accept": "application/json, text/event-stream"}, json={}).status_code == 401
+        )
+
