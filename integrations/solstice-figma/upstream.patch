+def mcp_client(service, app_harness, signing_material):
+    _, jwks = signing_material
+    app = build_mcp_app(
+        runtime_settings=Settings(AUTH0_DOMAIN="test.auth0.local", MCP_RESOURCE_URL=TEST_RESOURCE),
+        registry=app_harness.registry,
+        session_factory=app_harness.session_factory,
+        jwks_cache=JWKSCache(TEST_ISSUER + ".well-known/jwks.json", initial=jwks),
+        s3=app_harness.s3,
+        figma_service=service,
+    )
+    return TestClient(app.streamable_http_app(), base_url="https://mcp.test.local")
+
