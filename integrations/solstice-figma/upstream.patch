+@pytest.mark.parametrize(
+    "invalid", [None, "issuer", "audience", "nonce", "expired", "algorithm", "kid", "azp", "multi_aud"]
+)
+def test_auth0_browser_identity_verifies_signature_claims_nonce_and_pkce(signing_material, invalid):
+    import time
+
+    import jwt
+
+    from solstice_mcp.figma_identity import Auth0BrowserIdentity
+
+    private, jwks = signing_material
+    claims = {
+        "iss": TEST_ISSUER,
+        "aud": "gateway-link-client",
+        "sub": SHARED_SUB,
+        "iat": int(time.time()),
+        "exp": int(time.time()) + 120,
+        "nonce": "expected-nonce",
+    }
+    if invalid == "issuer":
+        claims["iss"] = "https://attacker.example/"
+    elif invalid == "audience":
+        claims["aud"] = "attacker-client"
+    elif invalid == "nonce":
+        claims["nonce"] = "other-nonce"
+    elif invalid == "expired":
+        claims["exp"] = int(time.time()) - 60
+    elif invalid == "azp":
+        claims["azp"] = "attacker-client"
+    elif invalid == "multi_aud":
+        claims["aud"] = ["gateway-link-client", "other-client"]
+    algorithm, key = ("HS256", "x" * 32) if invalid == "algorithm" else ("RS256", private)
+    token = jwt.encode(
+        claims, key, algorithm=algorithm, headers={"kid": "wrong-key" if invalid == "kid" else "test-key"}
+    )
+    requests = []
+
+    def handler(request):
+        requests.append(request)
+        return httpx.Response(200, json={"id_token": token, "access_token": "must-not-leave-identity-exchange"})
+
+    class Keys:
+        def get(self, *, refresh=False):
+            return jwks
+
+    client = httpx.Client(transport=httpx.MockTransport(handler))
+    identity = Auth0BrowserIdentity(
+        domain="test.auth0.local",
+        client_id="gateway-link-client",
+        client_secret="gateway-secret",
+        gateway_origin="https://mcp.test.local",
+        client=client,
+        jwks=Keys(),
+    )
+    authorization = parse_qs(
+        urlsplit(identity.authorization_url(state="state", nonce="expected-nonce", verifier="v" * 64)).query
+    )
+    assert authorization["code_challenge_method"] == ["S256"] and authorization["prompt"] == ["login"]
+    assert authorization["scope"] == ["openid"]
+    if invalid:
+        with pytest.raises(FigmaError, match="identity_failed"):
+            identity.exchange(code="code", verifier="v" * 64, nonce="expected-nonce")
+    else:
+        assert identity.exchange(code="code", verifier="v" * 64, nonce="expected-nonce") == SHARED_SUB
+    assert len(requests) == 1 and str(requests[0].url) == TEST_ISSUER + "oauth/token"
+    sent = json.loads(requests[0].content)
+    assert sent["code_verifier"] == "v" * 64 and sent["client_secret"] == "gateway-secret"
+    assert sent["redirect_uri"] == "https://mcp.test.local/mcp/figma/identity/callback"
+    assert "authorization" not in requests[0].headers
+    client.close()
