+++ b/migrations/20261014_figma.sql
@@ -0,0 +1,25 @@
+-- Explicit operator-applied PostgreSQL migration. No application create_all.
+BEGIN;
+CREATE TABLE solstice_figma_schema (version INTEGER PRIMARY KEY CHECK (version = 1));
+INSERT INTO solstice_figma_schema (version) VALUES (1);
+CREATE TABLE solstice_figma_grants (
+    subject VARCHAR(255) NOT NULL,
+    client_id VARCHAR(255) NOT NULL,
+    figma_user_id VARCHAR(255),
+    payload TEXT,
+    expires_at BIGINT NOT NULL DEFAULT 0,
+    generation INTEGER NOT NULL DEFAULT 0,
+    PRIMARY KEY (subject, client_id),
+    CONSTRAINT uq_solstice_figma_account UNIQUE (client_id, figma_user_id)
+);
+CREATE TABLE solstice_figma_oauth_states (
+    state_hash VARCHAR(64) PRIMARY KEY,
+    subject VARCHAR(255) NOT NULL,
+    client_id VARCHAR(255) NOT NULL,
+    verifier TEXT NOT NULL,
+    expires_at BIGINT NOT NULL,
+    generation INTEGER NOT NULL
+);
+CREATE INDEX ix_solstice_figma_oauth_states_subject ON solstice_figma_oauth_states(subject);
+CREATE INDEX ix_solstice_figma_oauth_states_expires_at ON solstice_figma_oauth_states(expires_at);
+COMMIT;
