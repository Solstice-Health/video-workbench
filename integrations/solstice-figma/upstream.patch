@@ -0,0 +1,123 @@
+"""Browser OIDC proof prevents Figma account-linking CSRF across MCP users."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import re
+import time
+from urllib.parse import urlencode, urlsplit
+
+import httpx
+import jwt
+
+from solstice_mcp.auth import JWKSCache
+from solstice_mcp.figma import FigmaError
+
+
+class Auth0BrowserIdentity:
+    def __init__(
+        self,
+        *,
+        domain: str,
+        client_id: str,
+        client_secret: str,
+        gateway_origin: str,
+        client: httpx.Client | None = None,
+        jwks: JWKSCache | None = None,
+    ):
+        if not re.fullmatch(r"[A-Za-z0-9.-]+", domain) or not client_id or not client_secret:
+            raise ValueError("A separate registered Auth0 gateway web client is required for Figma linking")
+        origin = urlsplit(gateway_origin)
+        if origin.scheme != "https" or not origin.hostname or origin.path or origin.query or origin.fragment:
+            raise ValueError("The Figma identity callback requires the HTTPS gateway origin")
+        self.issuer = f"https://{domain}/"
+        self.client_id, self.client_secret = client_id, client_secret
+        self.redirect_uri = gateway_origin + "/mcp/figma/identity/callback"
+        self.client = client or httpx.Client(timeout=httpx.Timeout(10, connect=5), follow_redirects=False)
+        self.jwks = jwks or JWKSCache(self.issuer + ".well-known/jwks.json")
+
+    def authorization_url(self, *, state: str, nonce: str, verifier: str) -> str:
+        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
+        return (
+            self.issuer
+            + "authorize?"
+            + urlencode(
+                {
+                    "client_id": self.client_id,
+                    "redirect_uri": self.redirect_uri,
+                    "response_type": "code",
+                    "scope": "openid",
+                    "state": state,
+                    "nonce": nonce,
+                    "code_challenge": challenge,
+                    "code_challenge_method": "S256",
+                    "prompt": "login",
+                }
+            )
+        )
+
+    def exchange(self, *, code: str, verifier: str, nonce: str) -> str:
+        started = time.monotonic()
+        try:
+            with self.client.stream(
+                "POST",
+                self.issuer + "oauth/token",
+                follow_redirects=False,
+                json={
+                    "grant_type": "authorization_code",
+                    "client_id": self.client_id,
+                    "client_secret": self.client_secret,
+                    "redirect_uri": self.redirect_uri,
+                    "code": code,
+                    "code_verifier": verifier,
+                },
+            ) as response:
+                if response.status_code != 200:
+                    raise FigmaError("figma_identity_failed: Sign in to Solstice again to connect Figma.")
+                data = bytearray()
+                for chunk in response.iter_bytes():
+                    if time.monotonic() - started > 30:
+                        raise FigmaError("figma_identity_failed: The identity response exceeded its time budget.")
+                    data.extend(chunk)
+                    if len(data) > 64 * 1024:
+                        raise FigmaError("figma_identity_failed: The identity response exceeded its limit.")
+            parsed = json.loads(data)
+            if not isinstance(parsed, dict):
+                raise ValueError
+            token = parsed.get("id_token")
+            if not isinstance(token, str) or len(token) > 32 * 1024:
+                raise ValueError
+            header = jwt.get_unverified_header(token)
+            if header.get("alg") != "RS256" or not isinstance(header.get("kid"), str):
+                raise ValueError
+            keys = self.jwks.get().get("keys", [])
+            match = next((key for key in keys if key.get("kid") == header["kid"]), None)
+            if match is None:
+                keys = self.jwks.get(refresh=True).get("keys", [])
+                match = next((key for key in keys if key.get("kid") == header["kid"]), None)
+            if match is None:
+                raise ValueError
+            claims = jwt.decode(
+                token,
+                jwt.PyJWK.from_dict(match).key,
+                algorithms=["RS256"],
+                issuer=self.issuer,
+                audience=self.client_id,
+                options={"require": ["iss", "aud", "sub", "exp", "iat", "nonce"]},
+            )
+            if not isinstance(claims["sub"], str) or not 1 <= len(claims["sub"]) <= 255:
+                raise ValueError
+            if not isinstance(claims["nonce"], str) or not hmac.compare_digest(claims["nonce"], nonce):
+                raise ValueError
+            if claims.get("azp", self.client_id) != self.client_id:
+                raise ValueError
+            if isinstance(claims["aud"], list) and len(claims["aud"]) > 1 and claims.get("azp") != self.client_id:
+                raise ValueError
+            return claims["sub"]
+        except FigmaError:
+            raise
+        except (httpx.HTTPError, OSError, RuntimeError, ValueError, KeyError, TypeError, jwt.PyJWTError) as exc:
+            raise FigmaError("figma_identity_failed: Sign in to Solstice again to connect Figma.") from exc
