+@pytest.mark.parametrize("format", ["png", "svg"])
+def test_mcp_exports_are_embedded_and_callback_does_not_echo_secrets(
+    setup, app_harness, signing_material, mint_token, format
+):
+    body = b"\x89PNG\r\n\x1a\n" if format == "png" else b'<svg xmlns="http://www.w3.org/2000/svg"/>'
+    mime = "image/png" if format == "png" else "image/svg+xml"
+    service, _ = images_service(setup, body=body, mime=mime)
+    with mcp_client(service, app_harness, signing_material) as client:
+        response = rpc(
+            client,
+            mint_token(),
+            "tools/call",
+            name="solstice_figma_get_images",
+            arguments={"file_key": "file123", "node_ids": ["1:2"], "format": format},
+        )
+        result = response.json()["result"]
+        assert not result.get("isError")
+        assert result["content"][0]["type"] == ("image" if format == "png" else "resource")
+        assert result["structuredContent"]["images"][0]["sha256"] == hashlib.sha256(body).hexdigest()
+        assert "body" not in result["structuredContent"]["images"][0]
+        failed = client.get("/mcp/figma/callback?state=bad&code=SECRET&error=<script>alert(1)</script>")
+        assert failed.status_code == 400
+        assert "SECRET" not in failed.text and "alert(1)" not in failed.text
+        assert failed.headers["cache-control"] == "no-store"
+        assert "nonce-" in failed.headers["content-security-policy"] and "window.close()" in failed.text
+
