+def rpc(client, token, method, **params):
+    headers = {"Accept": "application/json, text/event-stream", "Authorization": "Bearer " + token}
+    return client.post("/mcp", headers=headers, json={"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
+
