index 0000000..864d757
--- /dev/null
+++ b/src/solstice_mcp/figma.py
@@ -0,0 +1,553 @@
+"""Optional per-user Figma REST access. Not the official Figma MCP server.
+
+No Auth0 token crosses the Figma boundary. Token/code bodies never enter logs or
+MCP results. PostgreSQL serializes each subject's refresh across gateway workers.
+The explicit migration must be applied by an operator before enabling this module.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import math
+import re
+import secrets
+import time
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any
+from urllib.parse import urlencode, urlsplit
+
+import httpx
+from cryptography.fernet import Fernet, InvalidToken, MultiFernet
+from sqlalchemy import BigInteger, Integer, String, Text, UniqueConstraint, delete, select, text
+from sqlalchemy.dialects.postgresql import insert as pg_insert
+from sqlalchemy.dialects.sqlite import insert as sqlite_insert
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column
+
+if TYPE_CHECKING:
+    from solstice_mcp.figma_identity import Auth0BrowserIdentity
+
+API = "https://api.figma.com"
+AUTHORIZE = "https://www.figma.com/oauth"
+SCOPES = "file_content:read current_user:read"
+STATE_SECONDS = 600
+MAX_JSON_BYTES = 2 * 1024 * 1024
+MAX_IMAGE_BYTES = 4 * 1024 * 1024
+MAX_TOTAL_IMAGE_BYTES = 8 * 1024 * 1024
+CDN_HOSTS = frozenset({"s3-alpha.figma.com", "s3-alpha-sig.figma.com", "figma-alpha-api.s3.us-west-2.amazonaws.com"})
+
+
+class FigmaError(RuntimeError):
+    """Only fixed, credential-free messages may be raised across the tool boundary."""
+
+
+class FigmaHTTPError(FigmaError):
+    def __init__(self, status: int):
+        self.status = status
+        super().__init__(f"figma_http_{status}: Figma could not complete this request.")
+
+
+class FigmaBase(DeclarativeBase):
+    pass
+
+
+class FigmaGrant(FigmaBase):
+    __tablename__ = "solstice_figma_grants"
+    __table_args__ = (UniqueConstraint("client_id", "figma_user_id", name="uq_solstice_figma_account"),)
+    subject: Mapped[str] = mapped_column(String(255), primary_key=True)
+    client_id: Mapped[str] = mapped_column(String(255), primary_key=True)
+    figma_user_id: Mapped[str | None] = mapped_column(String(255), nullable=True)
+    payload: Mapped[str | None] = mapped_column(Text, nullable=True)
+    expires_at: Mapped[int] = mapped_column(BigInteger, default=0)
+    generation: Mapped[int] = mapped_column(Integer, default=0)
+
+
+class FigmaPending(FigmaBase):
+    __tablename__ = "solstice_figma_oauth_states"
+    state_hash: Mapped[str] = mapped_column(String(64), primary_key=True)
+    subject: Mapped[str] = mapped_column(String(255), index=True)
+    client_id: Mapped[str] = mapped_column(String(255))
+    verifier: Mapped[str] = mapped_column(Text)
+    expires_at: Mapped[int] = mapped_column(BigInteger, index=True)
+    generation: Mapped[int] = mapped_column(Integer)
+
+
+@dataclass(frozen=True)
+class FigmaConfig:
+    client_id: str
+    client_secret: str = field(repr=False)
+    redirect_uri: str
+    vault_keys: str = field(repr=False)
+
+    def __post_init__(self):
+        url = urlsplit(self.redirect_uri)
+        if not self.client_id or len(self.client_id) > 255 or not self.client_secret or not self.vault_keys:
+            raise ValueError("Complete Figma OAuth and vault settings are required.")
+        if (
+            url.scheme != "https"
+            or not url.hostname
+            or url.username
+            or url.password
+            or url.query
+            or url.fragment
+            or url.path != "/mcp/figma/callback"
+        ):
+            raise ValueError("FIGMA_REDIRECT_URI must be an HTTPS /mcp/figma/callback URL without a query.")
+
+
+class FigmaVault:
+    def __init__(self, sessions: Callable[[], Session], config: FigmaConfig, *, allow_sqlite: bool = False):
+        self.sessions, self.config, self.allow_sqlite = sessions, config, allow_sqlite
+        try:
+            self.cipher = MultiFernet([Fernet(key.strip().encode()) for key in config.vault_keys.split(",")])
+        except (ValueError, TypeError) as exc:
+            raise ValueError("FIGMA_VAULT_KEYS must contain valid Fernet keys, newest first.") from exc
+
+    def validate_schema(self) -> None:
+        with self.sessions() as session:
+            self._dialect(session)
+            if session.execute(text("SELECT version FROM solstice_figma_schema")).scalar_one() != 1:
+                raise ValueError("Apply the explicit Solstice Figma schema version 1 migration before enabling it.")
+            # Confirm columns exist without reading any grant data.
+            session.execute(select(FigmaGrant).limit(0))
+            session.execute(select(FigmaPending).limit(0))
+
+    def _dialect(self, session: Session) -> str:
+        dialect = session.get_bind().dialect.name
+        if dialect != "postgresql" and not (dialect == "sqlite" and self.allow_sqlite):
+            raise ValueError("Figma grants require PostgreSQL; SQLite is supported only by explicit tests.")
+        return dialect
+
+    @contextmanager
+    def transaction(self) -> Iterator[Session]:
+        with self.sessions() as session:
+            try:
+                if self._dialect(session) == "sqlite":
+                    session.execute(text("BEGIN IMMEDIATE"))
+                else:
+                    session.execute(text("SET LOCAL lock_timeout = '10s'"))
+                yield session
+                session.commit()
+            except Exception:
+                session.rollback()
+                raise
+
+    def locked_grant(self, session: Session, subject: str, *, create: bool = False) -> FigmaGrant | None:
+        if not isinstance(subject, str) or not 1 <= len(subject) <= 255:
+            raise FigmaError("figma_identity_invalid: An authenticated subject is required.")
+        if create:
+            insert = pg_insert if self._dialect(session) == "postgresql" else sqlite_insert
+            session.execute(
+                insert(FigmaGrant)
+                .values(subject=subject, client_id=self.config.client_id, expires_at=0, generation=0)
+                .on_conflict_do_nothing()
+            )
+        return session.execute(
+            select(FigmaGrant)
+            .where(FigmaGrant.subject == subject, FigmaGrant.client_id == self.config.client_id)
+            .with_for_update()
+        ).scalar_one_or_none()
+
+    def seal(self, binding: str, value: dict) -> str:
+        return self.cipher.encrypt(json.dumps({"binding": binding, "value": value}).encode()).decode()
+
+    def unseal(self, binding: str, value: str) -> dict:
+        try:
+            envelope = json.loads(self.cipher.decrypt(value.encode()))
+            if envelope["binding"] != binding or not isinstance(envelope["value"], dict):
+                raise ValueError
+            return envelope["value"]
+        except (InvalidToken, ValueError, TypeError, KeyError) as exc:
+            raise FigmaError("figma_vault_invalid: The saved grant could not be verified. Reconnect Figma.") from exc
+
+    def binding(self, subject: str, purpose: str) -> str:
+        return json.dumps([self.config.client_id, subject, purpose])
+
+
+class FigmaService:
+    def __init__(
+        self,
+        vault: FigmaVault,
+        *,
+        identity: Auth0BrowserIdentity,
+        client: httpx.Client | None = None,
+        now: Callable[[], float] = time.time,
+    ):
+        self.vault, self.config, self.now, self.identity = vault, vault.config, now, identity
+        self.client = client or httpx.Client(timeout=httpx.Timeout(15, connect=5), follow_redirects=False)
+
+    def _bytes(self, method: str, url: str, *, cap: int, **kwargs) -> tuple[bytes, str]:
+        started = time.monotonic()
+        try:
+            with self.client.stream(method, url, follow_redirects=False, **kwargs) as response:
+                if response.status_code != 200:
+                    raise FigmaHTTPError(response.status_code)
+                length = response.headers.get("content-length")
+                if length and (not length.isdigit() or int(length) > cap):
+                    raise FigmaError("figma_response_too_large: Select fewer nodes or a smaller render scale.")
+                body = bytearray()
+                for chunk in response.iter_bytes():
+                    if time.monotonic() - started > 30:
+                        raise FigmaError("figma_unavailable: Figma exceeded the response time budget.")
+                    body.extend(chunk)
+                    if len(body) > cap:
+                        raise FigmaError("figma_response_too_large: Select fewer nodes or a smaller render scale.")
+                return bytes(body), response.headers.get("content-type", "").split(";", 1)[0].lower()
+        except httpx.HTTPError as exc:
+            raise FigmaError("figma_unavailable: Figma did not respond. Try again later.") from exc
+
+    def _json(self, method: str, path: str, **kwargs) -> dict:
+        body, _ = self._bytes(method, API + path, cap=MAX_JSON_BYTES, **kwargs)
+        try:
+            result = json.loads(body)
+            if not isinstance(result, dict):
+                raise ValueError
+            return result
+        except (ValueError, UnicodeError) as exc:
+            raise FigmaError("figma_response_invalid: Figma returned an invalid response.") from exc
+
+    def _token(self, path: str, data: dict) -> dict:
+        result = self._json("POST", path, data=data, auth=(self.config.client_id, self.config.client_secret))
+        if (
+            not isinstance(result.get("access_token"), str)
+            or not result["access_token"]
+            or len(result["access_token"]) > 16_384
+            or type(result.get("expires_in")) is not int
+            or not 60 <= result["expires_in"] <= 366 * 86400
+        ):
+            raise FigmaError("figma_token_invalid: Reconnect Figma to obtain a valid grant.")
+        return result
+
+    def connect(self, subject: str) -> dict:
+        ticket = secrets.token_urlsafe(32)
+        state_hash = hashlib.sha256(ticket.encode()).hexdigest()
+        with self.vault.transaction() as session:
+            grant = self.vault.locked_grant(session, subject, create=True)
+            assert grant is not None
+            grant.generation += 1
+            session.execute(delete(FigmaPending).where(FigmaPending.expires_at < int(self.now())))
+            session.execute(
+                delete(FigmaPending).where(
+                    FigmaPending.subject == subject, FigmaPending.client_id == self.config.client_id
+                )
+            )
+            session.add(
+                FigmaPending(
+                    state_hash=state_hash,
+                    subject=subject,
+                    client_id=self.config.client_id,
+                    verifier=self.vault.seal(self.vault.binding(subject, state_hash), {"stage": "ticket"}),
+                    expires_at=int(self.now()) + STATE_SECONDS,
+                    generation=grant.generation,
+                )
+            )
+        origin = self.config.redirect_uri.removesuffix("/mcp/figma/callback")
+        return {
+            "configured": True,
+            "authorization_url": origin + "/mcp/figma/connect?" + urlencode({"ticket": ticket}),
+            "expires_in": STATE_SECONDS,
+        }
+
+    def _new_pending(self, subject: str, generation: int, expires: int, payload: dict) -> str:
+        state = secrets.token_urlsafe(32)
+        state_hash = hashlib.sha256(state.encode()).hexdigest()
+        with self.vault.transaction() as session:
+            grant = self.vault.locked_grant(session, subject)
+            if grant is None or grant.generation != generation or expires < self.now():
+                raise FigmaError("figma_state_invalid: Start a new Figma connection.")
+            session.add(
+                FigmaPending(
+                    state_hash=state_hash,
+                    subject=subject,
+                    client_id=self.config.client_id,
+                    verifier=self.vault.seal(self.vault.binding(subject, state_hash), payload),
+                    expires_at=expires,
+                    generation=generation,
+                )
+            )
+        return state
+
+    def _consume_pending(self, state: str, stage: str, browser_secret: str | None = None) -> tuple[str, int, int, dict]:
+        if not isinstance(state, str) or not re.fullmatch(r"[A-Za-z0-9_-]{43}", state):
+            raise FigmaError("figma_state_invalid: Start a new Figma connection.")
+        state_hash = hashlib.sha256(state.encode()).hexdigest()
+        valid = False
+        with self.vault.transaction() as session:
+            pending = session.get(FigmaPending, state_hash)
+            if pending is None or pending.client_id != self.config.client_id:
+                raise FigmaError("figma_state_invalid: Start a new Figma connection.")
+            subject, generation = pending.subject, pending.generation
+            grant = self.vault.locked_grant(session, subject)
+            session.expire(pending)
+            pending = session.execute(
+                select(FigmaPending).where(FigmaPending.state_hash == state_hash).with_for_update()
+            ).scalar_one_or_none()
+            if pending is None:
+                raise FigmaError("figma_state_invalid: Start a new Figma connection.")
+            expires = pending.expires_at
+            payload = self.vault.unseal(self.vault.binding(subject, state_hash), pending.verifier)
+            valid = (
+                grant is not None
+                and grant.generation == generation
+                and expires >= self.now()
+                and payload.get("stage") == stage
+            )
+            if stage != "ticket":
+                cookie_hash = hashlib.sha256((browser_secret or "").encode()).hexdigest()
+                valid = (
+                    valid
+                    and isinstance(browser_secret, str)
+                    and re.fullmatch(r"[A-Za-z0-9_-]{43}", browser_secret) is not None
+                    and hmac.compare_digest(payload.get("browser_hash", ""), cookie_hash)
+                )
+            session.delete(pending)
+        # Even a bad-cookie or denied callback consumes the state, outside rollback.
+        if not valid:
+            raise FigmaError("figma_state_invalid: Start a new Figma connection in the same browser.")
+        return subject, generation, expires, payload
+
+    def start_browser(self, ticket: str) -> dict:
+        subject, generation, expires, _ = self._consume_pending(ticket, "ticket")
+        browser_secret, nonce, verifier = (
+            secrets.token_urlsafe(32),
+            secrets.token_urlsafe(32),
+            secrets.token_urlsafe(48),
+        )
+        state = self._new_pending(
+            subject,
+            generation,
+            expires,
+            {
+                "stage": "identity",
+                "nonce": nonce,
+                "verifier": verifier,
+                "browser_hash": hashlib.sha256(browser_secret.encode()).hexdigest(),
+            },
+        )
+        return {
+            "url": self.identity.authorization_url(state=state, nonce=nonce, verifier=verifier),
+            "cookie": browser_secret,
+        }
+
+    def identity_callback(
+        self, *, state: str, code: str | None, browser_secret: str | None, error: str | None = None
+    ) -> dict:
+        subject, generation, expires, payload = self._consume_pending(state, "identity", browser_secret)
+        if error or not isinstance(code, str) or not 1 <= len(code) <= 2048:
+            raise FigmaError("figma_identity_failed: Start a new Figma connection.")
+        verified = self.identity.exchange(code=code, verifier=payload["verifier"], nonce=payload["nonce"])
+        if not hmac.compare_digest(verified.encode(), subject.encode()):
+            raise FigmaError("figma_identity_mismatch: Sign in using the same Solstice account as the Workbench.")
+        browser_secret, verifier = secrets.token_urlsafe(32), secrets.token_urlsafe(48)
+        state = self._new_pending(
+            subject,
+            generation,
+            expires,
+            {
+                "stage": "figma",
+                "verifier": verifier,
+                "browser_hash": hashlib.sha256(browser_secret.encode()).hexdigest(),
+            },
+        )
+        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
+        return {
+            "url": AUTHORIZE
+            + "?"
+            + urlencode(
+                {
+                    "client_id": self.config.client_id,
+                    "redirect_uri": self.config.redirect_uri,
+                    "scope": SCOPES,
+                    "state": state,
+                    "response_type": "code",
+                    "code_challenge": challenge,
+                    "code_challenge_method": "S256",
+                }
+            ),
+            "cookie": browser_secret,
+        }
+
+    def callback(
+        self, *, state: str, code: str | None, browser_secret: str | None = None, error: str | None = None
+    ) -> None:
+        subject, generation, _, payload = self._consume_pending(state, "figma", browser_secret)
+        verifier = payload["verifier"]
+        # State is durably consumed before network I/O, including denied/failed exchanges.
+        if error or not isinstance(code, str) or not 1 <= len(code) <= 2048:
+            raise FigmaError("figma_authorization_denied: Start a new Figma connection if you want to try again.")
+        token = self._token(
+            "/v1/oauth/token",
+            {
+                "redirect_uri": self.config.redirect_uri,
+                "code": code,
+                "grant_type": "authorization_code",
+                "code_verifier": verifier,
+            },
+        )
+        refresh = token.get("refresh_token")
+        user_id = token.get("user_id_string")
+        if (
+            not isinstance(refresh, str)
+            or not 1 <= len(refresh) <= 16_384
+            or not isinstance(user_id, str)
+            or not user_id
+        ):
+            raise FigmaError("figma_token_invalid: Reconnect Figma to obtain a valid grant.")
+        try:
+            with self.vault.transaction() as session:
+                grant = self.vault.locked_grant(session, subject)
+                if grant is None or grant.generation != generation:
+                    raise FigmaError(
+                        "figma_connection_superseded: A newer connection was started. Finish that connection."
+                    )
+                grant.figma_user_id, grant.expires_at = user_id, int(self.now()) + token["expires_in"]
+                grant.payload = self.vault.seal(
+                    self.vault.binding(subject, "grant"),
+                    {"access_token": token["access_token"], "refresh_token": refresh, "figma_user_id": user_id},
+                )
+        except IntegrityError as exc:
+            raise FigmaError(
+                "figma_account_linked: This Figma account is already linked to another Solstice identity."
+            ) from exc
+
+    def _access(self, subject: str, *, rejected: str | None = None) -> str:
+        with self.vault.transaction() as session:
+            grant = self.vault.locked_grant(session, subject)
+            if grant is None or not grant.payload:
+                raise FigmaError("figma_not_connected: Connect Figma from the integrations panel first.")
+            payload = self.vault.unseal(self.vault.binding(subject, "grant"), grant.payload)
+            token = payload["access_token"]
+            # A waiter whose rejected token was already replaced reuses the winner's token.
+            if grant.expires_at <= self.now() + 60 or rejected == token:
+                result = self._token("/v1/oauth/refresh", {"refresh_token": payload["refresh_token"]})
+                if result.get("user_id_string", grant.figma_user_id) != grant.figma_user_id:
+                    raise FigmaError("figma_token_invalid: Reconnect Figma to obtain a valid grant.")
+                refresh = result.get("refresh_token", payload["refresh_token"])
+                if not isinstance(refresh, str) or not 1 <= len(refresh) <= 16_384:
+                    raise FigmaError("figma_token_invalid: Reconnect Figma to obtain a valid grant.")
+                payload.update(access_token=result["access_token"], refresh_token=refresh)
+                grant.payload = self.vault.seal(self.vault.binding(subject, "grant"), payload)
+                grant.expires_at = int(self.now()) + result["expires_in"]
+                token = result["access_token"]
+            return token
+
+    def _get(self, subject: str, path: str, **kwargs) -> dict:
+        token = self._access(subject)
+        try:
+            return self._json("GET", path, headers={"Authorization": "Bearer " + token}, **kwargs)
+        except FigmaHTTPError as exc:
+            if exc.status not in (401, 403):
+                raise
+        # A 403 can mean permissions or an invalid token. Retry once after a
+        # serialized refresh, never silently broaden scopes or destroy the grant.
+        token = self._access(subject, rejected=token)
+        return self._json("GET", path, headers={"Authorization": "Bearer " + token}, **kwargs)
+
+    def status(self, subject: str) -> dict:
+        try:
+            user = self._get(subject, "/v1/me")
+            if not isinstance(user.get("id"), str) or not user["id"]:
+                raise FigmaError("figma_response_invalid: Figma returned an invalid account response.")
+            with self.vault.transaction() as session:
+                grant = self.vault.locked_grant(session, subject)
+                if grant is None or user["id"] != grant.figma_user_id:
+                    raise FigmaError("figma_identity_mismatch: Reconnect Figma.")
+            return {"configured": True, "connected": True, "state": "connected", "figma_user_id": user["id"]}
+        except FigmaError as exc:
+            return {"configured": True, "connected": False, "state": str(exc).partition(":")[0], "message": str(exc)}
+
+    @staticmethod
+    def _selectors(file_key: str, node_ids: list[str] | None, *, maximum: int = 50) -> list[str]:
+        if not isinstance(file_key, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", file_key):
+            raise ValueError("Use a Figma file key, not a URL or filesystem path.")
+        if node_ids is None:
+            return []
+        if (
+            not isinstance(node_ids, list)
+            or not 1 <= len(node_ids) <= maximum
+            or any(not isinstance(node, str) or not re.fullmatch(r"[A-Za-z0-9_:;-]{1,128}", node) for node in node_ids)
+        ):
+            raise ValueError(f"Provide between 1 and {maximum} Figma node IDs.")
+        return list(dict.fromkeys(node_ids))
+
+    def get_file(self, subject: str, file_key: str, node_ids: list[str] | None = None, depth: int = 2) -> dict:
+        ids = self._selectors(file_key, node_ids)
+        if type(depth) is not int or not 1 <= depth <= 10:
+            raise ValueError("Depth must be between 1 and 10; narrow node IDs for large files.")
+        params: dict[str, Any] = {"depth": depth}
+        if ids:
+            params["ids"] = ",".join(ids)
+        return {
+            "file_key": file_key,
+            "node_ids": ids,
+            "depth": depth,
+            "source_url": f"https://www.figma.com/design/{file_key}",
+            "data": self._get(subject, f"/v1/files/{file_key}" + ("/nodes" if ids else ""), params=params),
+        }
+
+    def get_images(
+        self, subject: str, file_key: str, node_ids: list[str], format: str = "png", scale: float = 1
+    ) -> dict:
+        ids = self._selectors(file_key, node_ids, maximum=8)
+        if (
+            not ids
+            or format not in {"png", "svg"}
+            or isinstance(scale, bool)
+            or not math.isfinite(scale)
+            or not 0.01 <= scale <= 4
+        ):
+            raise ValueError("Choose png or svg, 1-8 node IDs, and a finite scale between 0.01 and 4.")
+        payload = self._get(
+            subject, f"/v1/images/{file_key}", params={"ids": ",".join(ids), "format": format, "scale": scale}
+        )
+        images = payload.get("images")
+        if not isinstance(images, dict):
+            raise FigmaError("figma_response_invalid: Figma did not return an image map.")
+        outputs: list[dict[str, Any]] = []
+        total = 0
+        for node in ids:
+            url = images.get(node)
+            source = f"https://www.figma.com/design/{file_key}?" + urlencode({"node-id": node})
+            if url is None:
+                outputs.append({"node_id": node, "source_url": source, "error": "render_unavailable"})
+                continue
+            if not isinstance(url, str) or len(url) > 8192:
+                raise FigmaError("figma_image_url_invalid: Figma returned an unsupported image URL.")
+            parsed = urlsplit(url)
+            if (
+                parsed.scheme != "https"
+                or parsed.hostname not in CDN_HOSTS
+                or parsed.port not in (None, 443)
+                or parsed.username
+                or parsed.password
+                or parsed.fragment
+            ):
+                raise FigmaError("figma_image_url_invalid: The returned image host is not approved by this gateway.")
+            # A new request with NO Figma/Auth0 Authorization header, no redirects.
+            body, mime = self._bytes("GET", url, cap=min(MAX_IMAGE_BYTES, MAX_TOTAL_IMAGE_BYTES - total))
+            expected = "image/png" if format == "png" else "image/svg+xml"
+            if mime != expected or (format == "png" and not body.startswith(b"\x89PNG\r\n\x1a\n")):
+                raise FigmaError("figma_image_invalid: The returned artifact does not match the requested image type.")
+            if format == "svg":
+                try:
+                    if "<svg" not in body.decode("utf-8").lower():
+                        raise ValueError
+                except (UnicodeError, ValueError) as exc:
+                    raise FigmaError("figma_image_invalid: The returned artifact is not UTF-8 SVG.") from exc
+            total += len(body)
+            outputs.append(
+                {
+                    "node_id": node,
+                    "source_url": source,
+                    "mime_type": mime,
+                    "bytes": len(body),
+                    "sha256": hashlib.sha256(body).hexdigest(),
+                    "body": body,
+                }
+            )
+        return {"file_key": file_key, "format": format, "images": outputs}
