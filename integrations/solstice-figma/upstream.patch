+def test_forwarded_connect_ticket_cannot_link_victims_figma_to_attacker(setup):
+    service, vault, _, calls, _ = setup
+    result = service.connect("auth0|attacker")
+    ticket = parse_qs(urlsplit(result["authorization_url"]).query)["ticket"][0]
+    started = service.start_browser(ticket)
+    state = parse_qs(urlsplit(started["url"]).query)["state"][0]
+    service.identity.subject = "auth0|victim"
+    with pytest.raises(FigmaError, match="identity_mismatch"):
+        service.identity_callback(state=state, code="victim-code", browser_secret=started["cookie"])
+    assert not calls  # No Figma token exchange or request was made.
+    with vault.sessions() as session:
+        assert session.execute(select(FigmaPending)).scalar_one_or_none() is None
+        grant = session.execute(select(FigmaGrant)).scalar_one()
+        assert grant.subject == "auth0|attacker" and grant.payload is None
+
