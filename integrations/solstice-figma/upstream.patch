+def test_schema_is_explicit_and_production_rejects_sqlite(setup, tmp_path):
+    _, vault, _, _, _ = setup
+    vault.validate_schema()
+    with pytest.raises(ValueError, match="require PostgreSQL"):
+        FigmaVault(vault.sessions, vault.config).validate_schema()
+    engine = create_engine("sqlite:///" + str(tmp_path / "empty.sqlite"))
+    empty = FigmaVault(sessionmaker(engine), vault.config, allow_sqlite=True)
+    with pytest.raises(OperationalError):
+        empty.validate_schema()
+    assert not inspect(engine).get_table_names()
+    engine.dispose()
+
