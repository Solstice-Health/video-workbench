+def test_http_browser_flow_rotates_secure_cookie_and_has_no_open_redirect(setup, app_harness, signing_material):
+    service, _, _, _, _ = setup
+    result = service.connect(SHARED_SUB)
+    ticket = parse_qs(urlsplit(result["authorization_url"]).query)["ticket"][0]
+    with mcp_client(service, app_harness, signing_material) as client:
+        start = client.get(f"/mcp/figma/connect?ticket={ticket}&redirect=https://evil.example", follow_redirects=False)
+        assert start.status_code == 302 and urlsplit(start.headers["location"]).hostname == "test.auth0.local"
+        cookie = start.headers["set-cookie"]
+        for required in ("__Host-solstice-figma-link", "Secure", "HttpOnly", "SameSite=lax", "Path=/"):
+            assert required in cookie
+        first_cookie = client.cookies.get("__Host-solstice-figma-link")
+        state = parse_qs(urlsplit(start.headers["location"]).query)["state"][0]
+        verified = client.get(f"/mcp/figma/identity/callback?state={state}&code=identity-code", follow_redirects=False)
+        assert verified.status_code == 302 and urlsplit(verified.headers["location"]).hostname == "www.figma.com"
+        assert client.cookies.get("__Host-solstice-figma-link") != first_cookie
+        state = parse_qs(urlsplit(verified.headers["location"]).query)["state"][0]
+        final = client.get(f"/mcp/figma/callback?state={state}&code=figma-code", follow_redirects=False)
+        assert final.status_code == 200
+        assert not client.cookies.get("__Host-solstice-figma-link")
+        assert service.status(SHARED_SUB)["connected"]
+
