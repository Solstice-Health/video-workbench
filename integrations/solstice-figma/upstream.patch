@@ -0,0 +1,180 @@
+"""Figma REST tools with token-derived subjects and embedded export artifacts."""
+
+from __future__ import annotations
+
+import base64
+from collections.abc import Callable
+from typing import Any
+from urllib.parse import quote
+
+import anyio
+from mcp.server.fastmcp import FastMCP
+from mcp.types import (
+    CallToolResult,
+    ContentBlock,
+    EmbeddedResource,
+    ImageContent,
+    TextContent,
+    TextResourceContents,
+    ToolAnnotations,
+)
+from pydantic import AnyUrl
+from starlette.requests import Request
+from starlette.responses import HTMLResponse, RedirectResponse
+
+from solstice_mcp.audit import audited_tool
+from solstice_mcp.figma import FigmaError, FigmaService
+
+
+def register_figma_tools(
+    mcp: FastMCP, *, service: FigmaService, require_subject: Callable[[], str], require_access_token: Callable[[], Any]
+) -> None:
+    read = audited_tool(
+        mcp,
+        require_access_token,
+        annotations=ToolAnnotations(readOnlyHint=True, destructiveHint=False, idempotentHint=True, openWorldHint=True),
+    )
+    connect = audited_tool(
+        mcp,
+        require_access_token,
+        annotations=ToolAnnotations(
+            readOnlyHint=False, destructiveHint=False, idempotentHint=False, openWorldHint=True
+        ),
+    )
+
+    @read
+    def solstice_figma_status() -> dict[str, Any]:
+        """Verify this authenticated user's linked Figma account; never returns tokens."""
+        return service.status(require_subject())
+
+    @connect
+    def solstice_figma_connect() -> dict[str, Any]:
+        """Start linking YOUR Figma account, only after the user chooses Connect Figma.
+
+        Open authorization_url in the user's regular browser and sign in with the
+        same Solstice identity as this MCP client. Never use an embedded
+        WebView. Do not share that one-use URL with another person. The callback
+        binds the Figma account to this authenticated Solstice identity.
+        """
+        return service.connect(require_subject())
+
+    @read
+    def solstice_figma_get_file(file_key: str, node_ids: list[str] | None = None, depth: int = 2) -> dict[str, Any]:
+        """Read Figma file/node JSON at bounded depth using this user's Figma grant.
+
+        The Figma REST permission check is authoritative. Narrow node_ids or depth
+        after a response-size error. This is not official Figma MCP design context.
+        """
+        return service.get_file(require_subject(), file_key, node_ids, depth)
+
+    @read
+    def solstice_figma_get_images(
+        file_key: str, node_ids: list[str], format: str = "png", scale: float = 1
+    ) -> CallToolResult:
+        """Read PNG/SVG exports of 1-8 nodes as embedded artifacts, never provider tokens.
+
+        Exports are bounded to 4 MiB each and 8 MiB total. Null Figma renders are
+        disclosed individually. All image downloads happen on this gateway.
+        """
+        result = service.get_images(require_subject(), file_key, node_ids, format, scale)
+        content: list[ContentBlock] = []
+        for item in result["images"]:
+            body = item.pop("body", None)
+            if body is None:
+                continue
+            item["content_index"] = len(content)
+            if format == "png":
+                content.append(ImageContent(type="image", data=base64.b64encode(body).decode(), mimeType="image/png"))
+            else:
+                uri = f"figma://file/{file_key}/nodes/{quote(item['node_id'], safe='')}.svg"
+                content.append(
+                    EmbeddedResource(
+                        type="resource",
+                        resource=TextResourceContents(
+                            uri=AnyUrl(uri), mimeType="image/svg+xml", text=body.decode("utf-8")
+                        ),
+                    )
+                )
+        content.append(
+            TextContent(type="text", text="Figma exports are attached; per-node provenance is in structuredContent.")
+        )
+        return CallToolResult(content=content, structuredContent=result)
+
+    cookie_name = "__Host-solstice-figma-link"
+
+    def page(message: str, status: int) -> HTMLResponse:
+        import secrets
+
+        nonce = secrets.token_urlsafe(18)
+        response = HTMLResponse(
+            f'<!doctype html><meta charset="utf-8"><title>Figma connection</title>'
+            f'<p>{message}</p><script nonce="{nonce}">window.close()</script>',
+            status_code=status,
+            headers={
+                "Cache-Control": "no-store",
+                "Referrer-Policy": "no-referrer",
+                "X-Content-Type-Options": "nosniff",
+                "Content-Security-Policy": (
+                    f"default-src 'none'; script-src 'nonce-{nonce}'; frame-ancestors 'none'; base-uri 'none'"
+                ),
+            },
+        )
+        response.delete_cookie(cookie_name, path="/", secure=True, httponly=True, samesite="lax")
+        return response
+
+    def query_valid(request: Request, required: str) -> None:
+        if len(request.url.query) > 4096 or len(request.query_params.getlist(required)) != 1:
+            raise FigmaError("figma_state_invalid")
+        if any(len(request.query_params.getlist(key)) > 1 for key in ("code", "error")):
+            raise FigmaError("figma_state_invalid")
+
+    def redirect(result: dict) -> RedirectResponse:
+        response = RedirectResponse(
+            result["url"], status_code=302, headers={"Cache-Control": "no-store", "Referrer-Policy": "no-referrer"}
+        )
+        response.set_cookie(
+            cookie_name, result["cookie"], max_age=600, path="/", secure=True, httponly=True, samesite="lax"
+        )
+        return response
+
+    async def start(request: Request):
+        try:
+            query_valid(request, "ticket")
+            result = await anyio.to_thread.run_sync(lambda: service.start_browser(request.query_params["ticket"]))
+            return redirect(result)
+        except FigmaError:
+            return page("Figma could not be connected. Return to Video Workbench and start a new connection.", 400)
+
+    async def identity_callback(request: Request):
+        try:
+            query_valid(request, "state")
+            result = await anyio.to_thread.run_sync(
+                lambda: service.identity_callback(
+                    state=request.query_params["state"],
+                    code=request.query_params.get("code"),
+                    error=request.query_params.get("error"),
+                    browser_secret=request.cookies.get(cookie_name),
+                )
+            )
+            return redirect(result)
+        except FigmaError:
+            return page("Figma could not be connected. Sign in with the same Solstice account as Video Workbench.", 400)
+
+    async def callback(request: Request):
+        try:
+            query_valid(request, "state")
+            await anyio.to_thread.run_sync(
+                lambda: service.callback(
+                    state=request.query_params["state"],
+                    code=request.query_params.get("code"),
+                    error=request.query_params.get("error"),
+                    browser_secret=request.cookies.get(cookie_name),
+                )
+            )
+            return page("Figma connected. You can return to Video Workbench.", 200)
+        except FigmaError:
+            return page("Figma could not be connected. Return to Video Workbench and start a new connection.", 400)
+
+    mcp.custom_route("/mcp/figma/connect", methods=["GET"])(start)
+    mcp.custom_route("/mcp/figma/identity/callback", methods=["GET"])(identity_callback)
+    mcp.custom_route("/mcp/figma/callback", methods=["GET"])(callback)
