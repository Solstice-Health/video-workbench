# Video Workbench reads vendor keys from a .env file. It looks for VWB_ENV_FILE first,
# then the nearest .env walking up from the repo root. Provider keys stay in the
# control plane (the vwb process); agents never see them. Only allowlisted public
# hosting/Solstice settings below are also read; this file is never bulk-exported.

OPENAI_API_KEY=        # OpenAI models, image/audio/video/embedding APIs and existing helpers
GOOGLE_API_KEY=        # Google/Gemini models, multimodal generation, embeddings and video readers
# GEMINI_API_KEY=      # accepted Google alias when GOOGLE_API_KEY is unset
ANTHROPIC_API_KEY=     # direct Opus/Fable main agents; no desktop login fallback
EXA_API_KEY=           # optional; reserved for a future direct Exa adapter
OPENROUTER_API_KEY=    # OpenRouter model catalog/multimodal requests and web research; host gateway only

# Optional, nonsecret public HTTPS origin; see docs/PUBLIC_ACCESS.md.
# Read from this .env or the launching environment; --public-url takes precedence.
# Leave unset for default local access.
# VWB_UI_PUBLIC_URL=https://workbench.example
# Use your configured hostname, without a trailing slash, path, query or fragment.
# ngrok uses its existing host authtoken configuration; never commit the token
# or private launch links, and do not put them in this file.

# Optional built-in Solstice MCP. Register a public/native Workbench Auth0 client
# with S256 PKCE and this host's exact callback before connecting. No client secret
# is used. See docs/INTEGRATIONS.md and docs/PUBLIC_ACCESS.md.
# VWB_SOLSTICE_MCP_URL=https://api.solsticehealth.co/mcp
# VWB_SOLSTICE_CLIENT_ID=YOUR_REGISTERED_WORKBENCH_CLIENT_ID
# VWB_SOLSTICE_REDIRECT_URI=http://127.0.0.1:8765/api/integrations/solstice/callback
# For public hosting, set VWB_UI_PUBLIC_URL above and use that same HTTPS origin
# plus /api/integrations/solstice/callback here. Each callback needs registration.
# Environment settings override .env; settings saved in Manage connections
# override the Solstice defaults from either source. Restart after changing .env.
