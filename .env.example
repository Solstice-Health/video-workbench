# Video Workbench reads vendor keys from a .env file. It looks for VWB_ENV_FILE first,
# then the nearest .env walking up from the repo root. Only the keys below are read,
# and only the control plane (the vwb process) holds them; agents never see them.

OPENAI_API_KEY=        # gpt-6.1-sol: planner B, inner critic, second reading
GOOGLE_API_KEY=        # gemini-3.8-flash: video-native workers, watch, transcript reader 2
ANTHROPIC_API_KEY=     # optional; the main agent can also use the local Claude Code login
EXA_API_KEY=           # optional; reserved for a future direct Exa adapter
OPENROUTER_API_KEY=    # web_search, web_fetch, web_research; host gateway only
